<mujoco model="wheeled_robot">
  <option timestep="0.005" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.1"/>
    <geom contype="1" conaffinity="1" condim="3"/>
  </default>

  <worldbody>
    <!-- Ground plane -->
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.5 0.5 0.5 1" friction="1 0.005 0.0001"/>

    <!-- Torso: floats via freejoint, starts at z=0.5 -->
    <body name="torso" pos="0 0 0.5">
      <freejoint name="root"/>
      <geom name="torso_geom" type="box" size="0.05 0.025 0.075" mass="2.0" rgba="0.2 0.4 0.8 1"/>
      <site name="torso_imu" pos="0 0 0"/>

      <!-- LEFT LEG -->
      <body name="left_thigh" pos="0 0.06 -0.075">
        <geom name="left_thigh_geom" type="box" size="0.02 0.02 0.075" mass="0.3" rgba="0.3 0.6 0.3 1"/>
        <body name="left_shank" pos="0 0 -0.15">
          <joint name="left_knee_joint" type="hinge" axis="0 1 0" range="-1.5 0.2" damping="0.5"/>
          <geom name="left_shank_geom" type="box" size="0.015 0.015 0.05" mass="0.2" rgba="0.3 0.6 0.3 1"/>
          <body name="left_wheel_body" pos="0 0 -0.1">
            <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.05"/>
            <!-- cylinder axis along Y, radius=0.05, length=0.03 -->
            <geom name="left_wheel_geom" type="cylinder" size="0.05 0.015" mass="0.3"
                  fromto="0 -0.015 0 0 0.015 0" rgba="0.1 0.1 0.1 1" friction="1 0.005 0.0001"/>
          </body>
        </body>
      </body>

      <!-- RIGHT LEG -->
      <body name="right_thigh" pos="0 -0.06 -0.075">
        <geom name="right_thigh_geom" type="box" size="0.02 0.02 0.075" mass="0.3" rgba="0.6 0.3 0.3 1"/>
        <body name="right_shank" pos="0 0 -0.15">
          <joint name="right_knee_joint" type="hinge" axis="0 1 0" range="-1.5 0.2" damping="0.5"/>
          <geom name="right_shank_geom" type="box" size="0.015 0.015 0.05" mass="0.2" rgba="0.6 0.3 0.3 1"/>
          <body name="right_wheel_body" pos="0 0 -0.1">
            <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.05"/>
            <geom name="right_wheel_geom" type="cylinder" size="0.05 0.015" mass="0.3"
                  fromto="0 -0.015 0 0 0.015 0" rgba="0.1 0.1 0.1 1" friction="1 0.005 0.0001"/>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <actuator>
    <!-- Knee: position-controlled -->
    <position name="left_knee_act"  joint="left_knee_joint"  kp="40" kv="2"/>
    <position name="right_knee_act" joint="right_knee_joint" kp="40" kv="2"/>
    <!-- Wheels: velocity-controlled -->
    <velocity name="left_wheel_act"  joint="left_wheel_joint"  kv="2.0"/>
    <velocity name="right_wheel_act" joint="right_wheel_joint" kv="2.0"/>
  </actuator>

  <sensor>
    <gyro          name="torso_gyro"  site="torso_imu"/>
    <accelerometer name="torso_accel" site="torso_imu"/>
    <actuatorpos   name="left_knee_pos"   actuator="left_knee_act"/>
    <actuatorpos   name="right_knee_pos"  actuator="right_knee_act"/>
    <actuatorvel   name="left_wheel_vel"  actuator="left_wheel_act"/>
    <actuatorvel   name="right_wheel_vel" actuator="right_wheel_act"/>
  </sensor>

  <keyframe>
    <!--
      root freejoint qpos = x y z qw qx qy qz
      torso at z=0.5: thigh -0.075 + shank -0.15 + wheel -0.1 = -0.325 below torso
      wheel centre at 0.5 - 0.325 = 0.175; wheel radius=0.05 → bottom at 0.125
      Raise torso to 0.5 + 0.05 = 0.55 so wheel bottom just touches floor at z=0
      Actually: wheel centre z = 0.55 - 0.075 - 0.15 - 0.1 = 0.225; bottom = 0.225 - 0.05 = 0.175
      Let's set torso z = 0.5 + (0.05 - 0.175) = 0.375... easier to just set torso z high enough.
      torso z = 0.475 → wheel centre = 0.475 - 0.325 = 0.15 → bottom touches 0.1 (off ground)
      torso z = 0.375 + 0.05 = 0.375: wheel_centre = 0.05, bottom = 0
      torso z = 0.375 → wheel bottom = 0.375 - 0.325 - 0.05 = 0.0  ✓
    -->
    <key name="home" qpos="0 0 0.375 1 0 0 0  0 0  0 0"/>
  </keyframe>

</mujoco>
